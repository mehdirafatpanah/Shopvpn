[Unit]
Description=ShopVPN isolated SSH tunnel listener for account %i
After=network.target sshd.service ssh.service

[Service]
Type=simple
ExecStart=/usr/sbin/sshd -D -f /etc/shopvpn/sshd/%i.conf
Restart=on-failure
RestartSec=2
RuntimeDirectory=sshd-shopvpn-%i
RuntimeDirectoryMode=0755
User=root
Group=root
UMask=0077
# No sandboxing directives: NoNewPrivileges/ProtectSystem/PrivateTmp/RestrictAddressFamilies
# make OpenSSH 10 (Ubuntu 26.04) fail with "setresuid: Operation not permitted [preauth]".

[Install]
WantedBy=multi-user.target
